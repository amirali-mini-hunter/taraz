{
  "manifest_version": 3,
  "name": "تاراز | دستیار برنامه‌ریزی و رشد",
  "version": "1.0.0",
  "description": "یک شروع زیبا و کاربردی برای تب جدید شما همراه با تقویم جلالی، آب‌وهوا، یادداشت، میانبرهای فشرده و نمودارهای خطی پیشرفته تاراز",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aipass.one/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["oauth-callback.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
